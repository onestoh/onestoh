# ── Phase 3 environment variable additions ──────────────────────────────────
# Append these to your existing .env / .env.example

# Anthropic (AI Chat)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=1024

# MTN Mobile Money (Uganda collections + disbursements)
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_CALLBACK_URL=https://api.theonlineyard.co.ke/api/v1/webhooks/mtn-momo

# Stripe (international card payments)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Open Exchange Rates (multi-currency)
OPEN_EXCHANGE_RATES_APP_ID=

# AWS Rekognition (photo verification)
AWS_REKOGNITION_REGION=eu-west-1
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are shared with S3 config
