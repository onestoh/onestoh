APP_NAME=TheOnlineYard
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.theonlineyard.co.ke
FRONTEND_URL=https://theonlineyard.co.ke

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=onlineyard
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@theonlineyard.co.ke
MAIL_FROM_NAME="The Online Yard"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=theonlineyard-assets
AWS_USE_PATH_STYLE_ENDPOINT=false

# Safaricom Daraja
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASS_KEY=
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=
MPESA_SANDBOX=false

# Africa's Talking
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=TheYard

# Firebase FCM
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json

SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=
