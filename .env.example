APP_NAME=EstateYard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# For WAMP (adjust folder name to match your www subfolder):
# APP_URL=http://localhost/kan/onestoh/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── MySQL Database ──────────────────────────────────────────────────────────────────────────────
# 1. Create the database: CREATE DATABASE estateyard CHARACTER SET utf8mb4;
# 2. Import the dump:     mysql -u root -p estateyard < setup/estateyard_mysql.sql
# 3. Fill in credentials below
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=estateyard
DB_USERNAME=root
DB_PASSWORD=

# ─── Session & Cache (file-based — no Redis needed) ────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ─── Mail (log to file locally — no SMTP needed) ──────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@estateyard.com"
MAIL_FROM_NAME="EstateYard"

VITE_APP_NAME="${APP_NAME}"

# ─── EstateYard Config ──────────────────────────────────────────────────────────────────────────────
WHATSAPP_SUPPORT_NUMBER=254700000000
SUPPORT_EMAIL=support@estateyard.com
